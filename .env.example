# JAUAP — current Gemini configuration
# Copy to .env and fill in the Gemini key. Never commit .env.

# Gemini is the primary provider until the project owner explicitly changes it.
JAUAP_PROVIDER=gemini
GOOGLE_API_KEY=

# Optional: override the current Gemini model.
# JAUAP_MODEL=

# 1 = load frozen demo results, no network for the demo corpus
JAUAP_OFFLINE=1
