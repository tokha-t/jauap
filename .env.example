# JAUAP — provider configuration
# Copy to .env and fill in ONE provider's key. Never commit .env.

# gemini | groq | anthropic
JAUAP_PROVIDER=gemini

# Leave the ones you are not using empty.
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the per-provider default model
# JAUAP_MODEL=

# 1 = load frozen demo results, no network for the demo corpus
JAUAP_OFFLINE=1
